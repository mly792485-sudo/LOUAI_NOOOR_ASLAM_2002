# OpenAI API key used only by the server. Never put it in the mobile app.
OPENAI_API_KEY="MY_OPENAI_API_KEY"
OPENAI_MODEL="gpt-4o-mini"
# Optional OpenAI-compatible endpoint; leave unset for api.openai.com.
# OPENAI_BASE_URL="https://api.openai.com/v1/chat/completions"

# Public HTTPS URL used by the compiled iOS/Android app for the AI assistant.
# Never place OPENAI_API_KEY in the mobile app or in any VITE_* variable.
VITE_API_BASE_URL="https://your-api-domain.example"
# Optional public email address used by the in-app feedback form.
VITE_FEEDBACK_EMAIL="developer@example.com"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
